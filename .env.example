# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in what you need.
# `.env.local` is gitignored. Everything here is OPTIONAL - the site builds and
# runs correctly with no environment variables at all.
# ---------------------------------------------------------------------------

# Contact form delivery (optional).
# Create a free form at https://formspree.io, then paste its endpoint here.
# When this is unset, the contact form falls back to opening the visitor's
# email client with the message prefilled.
#
# NOTE: a Formspree endpoint is a public submission URL, not a secret. Never put
# a real API key in any NEXT_PUBLIC_* variable - those are inlined into the
# JavaScript that ships to every visitor's browser.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Privacy-friendly analytics (optional, DISABLED BY DEFAULT).
# Set to "true" and provide a domain to enable the Plausible script.
# Leave both empty and no analytics code is loaded or executed at all.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_DOMAIN=
